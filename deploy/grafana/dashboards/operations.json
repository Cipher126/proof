{
  "title": "Proof Operations",
  "uid": "proof-operations",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests per second", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "proof-prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (status) (rate(proof_http_requests_total[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "95th percentile latency (s)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "proof-prometheus"},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(proof_http_request_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "type": "timeseries", "title": "Outbox pending and dead letters", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "proof-prometheus"},
     "targets": [{"refId": "A", "expr": "proof_outbox_pending", "legendFormat": "Pending"},
                 {"refId": "B", "expr": "proof_outbox_dead_letters", "legendFormat": "Dead letters"}]},
    {"id": 4, "type": "timeseries", "title": "Open reconciliation findings", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "proof-prometheus"},
     "targets": [{"refId": "A", "expr": "proof_reconciliation_open"}]}
  ]
}
